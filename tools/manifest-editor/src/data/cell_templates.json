{
  "categories": [
    {
      "id": "knobs",
      "name": "Rotating Knobs",
      "icon": "🔘",
      "templates": [
        {
          "id": "std_knob",
          "name": "Standard Knob",
          "description": "Clean knob with bottom label",
          "items": [
            {
              "label": "Frequency",
              "type": "float",
              "front": true,
              "back": false,
              "roles": ["control", "mod_target"],
              "range": { "min": 0, "max": 1, "default": 0.5 },
              "presentation": {
                "ui": { "component": "knob", "variant": "B", "size": "medium" },
                "attachments": [
                  { "type": "label", "position": "bottom" }
                ]
              }
            }
          ]
        },
        {
          "id": "knob_with_display",
          "name": "Precision Knob",
          "description": "Knob with top value display",
          "items": [
            {
              "label": "Cutoff",
              "type": "float",
              "front": true,
              "back": false,
              "roles": ["control", "mod_target"],
              "presentation": {
                "ui": { "component": "knob", "variant": "A", "size": "medium" },
                "attachments": [
                  { "type": "display", "position": "top", "unit": "Hz" },
                  { "type": "label", "position": "bottom" }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "ports",
      "name": "Aseptic Ports",
      "icon": "🔌",
      "templates": [
        {
          "id": "audio_in",
