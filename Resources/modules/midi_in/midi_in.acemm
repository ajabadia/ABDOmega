schemaVersion: 7.0
id: midi_in
metadata:
  name: MIDI IN
  family: io
  tags:
    - era7
    - industrial
    - infrastructure
  rack:
    slot: upper
    hp: 4
    height_mode: compact
  status: beta
  registry:
    - id: led_activity
      label: MIDI ACT
      roles: [telemetry, internal]
      direction: internal
    - id: midi_out
      label: MIDI OUT
      roles: [output, stream]
      direction: output
      type: midi
ui:
  dimensions:
    width: 60
    height: 140
  controls:
    - id: led_activity
      type: knob
      role: telemetry
      bind: led_activity
      label: MIDI ACT
      pos:
        x: 30
        'y': 35
      presentation:
        tab: MAIN
        variant: red_3mm
        component: led
        group: STATUS
        offsetX: 0
        offsetY: 0
        container: MONITORING
        attachments:
          - type: label
            position: bottom
            offsetX: 0
            offsetY: -12
            variant: B_cyan
            text: MIDI ACT
        precision: 6
        ui_precision: 2
  jacks:
    - id: port_midi_out
      type: string
      role: stream
      bind: midi_out
      label: MIDI OUT
      pos:
        x: 30
        'y': 85
      presentation:
        tab: MAIN
        variant: industrial
        component: port
        color: orange
        group: BUS
        offsetX: 0
        offsetY: 0
        container: MONITORING
        attachments:
          - type: label
            position: bottom
            offsetX: 0
            offsetY: -12
            variant: B_cyan
            text: MIDI DATA
        precision: 6
        ui_precision: 2
  skin: industrial
  layout:
    containers:
      - id: MONITORING
        label: MIDI IN
        pos:
          x: 0
          'y': 15
        size:
          w: full
          h: 110
        variant: header
        tab: MAIN
        collapsed: false
      - id: STATUS
        label: Status
        pos:
          x: 5
          'y': 25
        size:
          w: 50
          h: 45
        variant: inset
        tab: MAIN
      - id: BUS
        label: MIDI Data
        pos:
          x: 5
          'y': 75
        size:
          w: 50
          h: 45
        variant: inset
        tab: MAIN
    gridSnap: 5
    activeTab: MAIN
resources:
  wasm: midi_in.wasm
  contract: midi_in.contract.json
modulations: []
