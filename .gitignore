# Ignore everything by default
/*

# Except these (Source and Documentation)
!/src/
!/Resources/
!/docs/
!/scripts/
!/README.md
!/ROADMAP.md
!/changelog.md
!/build_no.txt
!/CMakeLists.txt
!/ui/
!/.gitignore
!/RULES.md
!/BUILD.md
!/DEVELOPMENT_RULES.md

# Subdirectories
!/src/**
!/Resources/**
!/docs/**
!/scripts/**
!/ui/**

# Exclude specific heavy or binary files
*.exe
*.log
*.pdb
*.obj
*.o
*.output
*.errors
.vs/
.vscode/
build*/
OMEGABOOTLOG.txt
OMEGA_BOOT_LOG.txt

# Heavy folders to exclude explicitly
/JUCE/
/REFERENCE/
/CMake/
/build/
