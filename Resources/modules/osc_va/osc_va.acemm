id: osc_va
name: JUNO DCO
family: osc
version: "6.3"
registry:
  - id: layer.a.osc.saw.on
    label: SAW-TEST
    roles:
      - control
    range:
      min: 0
      max: 1
      default: 0
    front: true
    back: false
  - id: layer.a.osc.pulse.on
    label: PULSE
    roles:
      - control
    range:
      min: 0
      max: 1
      default: 1
    front: true
    back: false
  - id: layer.a.osc.sub.level
    label: SUB
    roles:
      - control
      - mod_target
    range:
      min: 0
      max: 1
      default: 0.5
    front: true
    back: false
  - id: layer.a.osc.noise.level
    label: NOISE
    roles:
      - control
      - mod_target
    range:
      min: 0
      max: 1
      default: 0
    front: true
    back: false
  - id: layer.a.osc.lfo.depth
    label: LFO
    roles:
      - control
      - mod_target
    range:
      min: 0
      max: 1
      default: 0
    front: true
    back: false
  - id: v_out
    label: V_OUT
    type: audio
    roles:
      - output
      - stream
    front: true
    back: false
