schemaVersion: '7.1'
id: midi_in
metadata:
  name: MIDI Input
  family: utility
  tags:
    - era7.1
    - industrial
  rack:
    slot: top
    height_mode: compact
    hp: 6
  status: beta
  description: Canonical MIDI Input Bridge for the OMEGA Rack
ui:
  dimensions:
    width: 120
    height: 420
  controls:
    - id: disp_mode
      type: knob
      role: control
      bind: mode_select
      label: Mode
      pos:
        x: 60
        'y': 140
      presentation:
        tab: MAIN
        variant: B_cyan
        component: display
        offsetX: 0
        offsetY: 0
        attachments:
          - type: label
            position: top
            offsetX: 0
            offsetY: -4
            variant: B_cyan
            text: OPERATING MODE
        precision: 6
        ui_precision: 2
    - id: ctrl_mode_select
      type: knob
      role: control
      bind: mode_select
      label: Mode
      pos:
        x: 60
        'y': 220
      presentation:
        tab: MIDI
        variant: B_cyan
        component: select
        offsetX: 0
        offsetY: 0
        attachments: []
        precision: 6
        ui_precision: 2
  jacks:
    - id: port_cv_out
      type: knob
      role: control
      bind: cv_out
      label: Pitch CV
      pos:
        x: 30
        'y': 80
      presentation:
        tab: PATCHING
        variant: A_cyan
        component: port
        offsetX: 0
        offsetY: 0
        attachments:
          - type: label
            position: bottom
            offsetX: 0
            offsetY: 2
            variant: B_cyan
        precision: 6
        ui_precision: 2
    - id: port_gate_out
      type: knob
      role: control
      bind: gate_out
      label: Gate Out
      pos:
        x: 90
        'y': 80
      presentation:
        tab: PATCHING
        variant: B_silver
        component: port
        offsetX: 0
        offsetY: 0
        attachments:
          - type: label
            position: bottom
            offsetX: 0
            offsetY: 2
            variant: B_cyan
        precision: 6
        ui_precision: 2
    - id: led_activity
      type: knob
      role: control
      bind: cv_out
      label: Activity
      pos:
        x: 60
        'y': 30
      presentation:
        tab: MAIN
        variant: B_red
        component: led
        offsetX: 0
        offsetY: 0
        attachments:
          - type: label
            position: right
            offsetX: 6
            offsetY: 0
            variant: B_cyan
            text: MIDI
        precision: 6
        ui_precision: 2
  skin: industrial
resources:
  wasm: midi_in.wasm
  contract: midi_in.contract.json
modulations: []
