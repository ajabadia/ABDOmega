              "roles": ["control"],
              "presentation": { "ui": { "component": "slider_v", "size": "medium" }, "attachments": [{ "type": "label", "position": "bottom" }] }
            },
            {
              "id_suffix": "release",
              "label": "Release",
              "type": "float",
              "roles": ["control"],
              "presentation": { "ui": { "component": "slider_v", "size": "medium" }, "attachments": [{ "type": "label", "position": "bottom" }] }
