id: "midi_2_cv"
name: "MIDI to CV Converter"
family: "Utility"
engine: "Modular"
modelId: "ACE-UTIL-MCV"
implementationId: 502
origin: "ABD OMEGA"
status: "active"
version: 1
visible: true
rack: "upper"
panelClass: "utility-panel"
description: "Pro-Grade MIDI to CV converter. Extends basic extraction with Glide, Bend and Multi-Mode Aftertouch."
tags: ["midi", "cv", "utility", "converter", "mpe"]
parameters:
  - id: "midi_channel"
    label: "CHANNEL"
    semantic: "list"
    visibility: ["back"]
    min: 0
    max: 16
    default: 0
    options:
      - { label: "OMNI", value: 0 }
      - { label: "CH 1", value: 1 }
      - { label: "CH 16", value: 16 }
  - id: "glide_mode"
    label: "GLIDE MODE"
    semantic: "list"
    default: 0
    options:
      - { label: "TIME CONSTANT", value: 0 }
      - { label: "VEL CONSTANT", value: 1 }
  - id: "glide_time"
    label: "PORTAMENTO"
    semantic: "number"
    visibility: ["back"]
    min: 0
    max: 2000
    default: 0
    unit: "ms"
  - id: "bend_range"
    label: "BEND RANGE"
    semantic: "number"
    visibility: ["back"]
    min: 0
    max: 12
    default: 2
    unit: "st"
  - id: "aftertouch_mode"
    label: "AF MODE"
    semantic: "list"
    default: 0
    options:
      - { label: "CHANNEL (MONO)", value: 0 }
      - { label: "POLYPHONIC", value: 1 }
ports:
  - id: "midi_in"
    label: "MIDI IN"
    type: "midi"
    direction: "input"
  - id: "pitch"
    label: "PITCH"
    type: "voltage"
    direction: "output"
  - id: "gate"
    label: "GATE"
    type: "logic"
    direction: "output"
  - id: "velocity"
    label: "VELOCITY"
    type: "voltage"
    direction: "output"
  - id: "aftertouch"
    label: "AFTOUCH"
    type: "voltage"
    direction: "output"
uiLayout:
  columns: 1
  rows: 4
  items:
    - { id: "chan_sel", semantic: "list", look: "display", variant: "A", paramId: "midi_channel", row: 0, col: 0 }
    - { id: "pitch_out", semantic: "port", look: "jack", portId: "pitch", row: 1, col: 0, label: "PITCH" }
    - { id: "gate_out", semantic: "port", look: "jack", portId: "gate", row: 2, col: 0, label: "GATE" }
    - { id: "activity_led", semantic: "telemetry", look: "led", variant: "A", label: "ACTIVITY", row: 3, col: 0, color: "yellow", source: "telemetry.activity" }
footer:
  label: "PRO CONVERTER"
